# Postgres connection string (Drizzle + better-auth).
DATABASE_URL=

# Guest mode: generations allowed per IP per UTC day (default 5), and an
# optional salt for the IP hash that seeds guest identities.
GUEST_DAILY_LIMIT=5
# GUEST_SALT=

# better-auth (openssl rand -base64 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Trigger.dev.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# RunPod serverless endpoint running the FLUX.1-schnell ComfyUI graph
# (see README.md's "RunPod endpoint setup").
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Any S3-compatible storage bucket (r2Storage works against Cloudflare R2 or
# any other S3-compatible endpoint).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
