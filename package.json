{
  "name": "studio-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter='*' typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix --unsafe",
    "build": "bun run --filter='./apps/*' build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^6",
    "ultracite": "7.7.0"
  }
}
